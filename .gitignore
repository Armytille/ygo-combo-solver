# Sorties de build
bin/
obj/
build/

# Replays produits par --outdir
solutions/
solutions_*/
archive_runs/

# Sorties des campagnes de runs (sessions 4-5 : mA_*..mO_*, sA_*..sY_* ;
# sessions 6-7 : sZ6_*, s7_*)
m[A-Z]*_*/
s[0-9A-Z]*_*/

# Logs et fichiers de travail
*.log

__pycache__/

# --- portage WebAssembly ---
# Liste BLANCHE : dans wasm/, tout est genere (build, objets, assets
# rassembles, sorties de runs, amalgamation sqlite copiee depuis vcpkg) sauf les
# quelques sources ci-dessous. Une liste noire se serait fait deborder au
# premier repertoire de mesure.
wasm/*
!wasm/build_wasm.ps1
!wasm/patch_features.py
!wasm/sqlite/
wasm/sqlite/*
!wasm/sqlite/sqlite3-vcpkg-config.h
!wasm/web/
wasm/web/*
!wasm/web/index.html
!wasm/web/serve.py
!wasm/web/mesure.mjs
!wasm/web/etalonB.yrpX
